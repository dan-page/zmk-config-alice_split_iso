#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
          &kp GRAVE          &kp ESCAPE      &kp NUMBER_1  &kp NUMBER_2   &kp NUMBER_3      &kp NUMBER_4          &kp N5            &kp NUMBER_6
          &kp C_VOLUME_UP    &kp TAB         &kp Q         &kp W          &kp E             &kp R                 &kp T
          &kp C_VOLUME_DOWN  &lt 1 CAPSLOCK  &kp A         &kp S          &kp D             &kp F                 &kp G
          &kp UP_ARROW       &kp LEFT_SHIFT  &kp Z         &kp X          &kp C             &kp V                 &kp B
&kp LEFT  &kp DOWN           &kp RIGHT       &kp LCTRL     &kp LEFT_GUI                     &kp SPACE
&kp N7    &kp N8             &kp N9          &kp N0        &kp MINUS      &kp EQUAL         &kp BACKSPACE
&kp Y     &kp U              &kp I           &kp O         &kp P          &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&kp H     &kp J              &kp K           &kp L         &kp SEMICOLON  &kp SQT           &kp NON_US_BACKSLASH  &kp ENTER
&kp B     &kp N              &kp M           &kp COMMA     &kp PERIOD     &kp SLASH         &kp RIGHT_SHIFT       &lt 1 LEFT_SHIFT
          &kp SPACE                          &kp RGUI                     &kp RIGHT_ALT     &kp RCTRL
            >;
        };

        layer_1 {
            bindings = <
        &trans  &trans  &kp F1   &kp F2   &kp F3   &kp F4  &kp F5  &kp F6
        &trans  &trans  &trans   &trans   &trans   &trans  &trans
        &trans  &trans  &trans   &trans   &trans   &trans  &trans
        &trans  &trans  &trans   &trans   &trans   &trans  &trans
&trans  &trans  &trans  &trans   &trans            &trans
&kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &trans
&trans  &trans  &trans  &trans   &trans   &trans   &trans
&trans  &trans  &trans  &trans   &trans   &trans   &trans  &trans
&trans  &trans  &trans  &trans   &trans   &trans   &trans  &trans
        &trans          &trans            &trans   &trans
            >;
        };
    };
};
